{
  "expo": {
    "name": "ConstructOS",
    "slug": "constructos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.constructos.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "ConstructOS saves a file to your photo library only when you choose Save Image from the share sheet."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.constructos.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "ConstructOS keeps your sign-in in the iOS Keychain. Face ID is used only if a protected sign-in item on this device needs to be unlocked."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ConstructOS uses the camera when you add a photo to a delivery record, for example to photograph a delivery receipt or the delivered materials.",
          "photosPermission": "ConstructOS only accesses photos that you choose to attach to a delivery record. It does not browse or upload your photo library on its own.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3b82f6"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "constructos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "36ad1557-da2f-4119-8dd2-3f8b282e5ce5"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "dalmarmudu"
  }
}
