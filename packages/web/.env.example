# ─── API URL ──────────────────────────────────────────────────────────────────
# The web app proxies all /api/v1/* requests to this URL via Next.js rewrites.
# In development: http://localhost:3001  (Fastify API server)
# In Railway production: set to your API service Railway URL (no trailing slash)
#
# This value is exposed to the browser (NEXT_PUBLIC_*). It is the API base URL,
# not a secret. Do not put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:3001
