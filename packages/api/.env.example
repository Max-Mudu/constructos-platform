# ─── Database ─────────────────────────────────────────────────────────────────
# Railway provides DATABASE_URL automatically when a PostgreSQL service is
# linked to your deployment. Copy it from the Railway Variables tab.
DATABASE_URL="postgresql://postgres:password@localhost:5432/construction_platform"

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Generate production secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Run twice — use one value for JWT_SECRET, a DIFFERENT value for JWT_REFRESH_SECRET.
# Both must be at least 32 characters; the server refuses to start in production
# if either secret is shorter.
JWT_SECRET="change-this-to-a-long-random-secret-minimum-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret-minimum-32-chars"

# ─── Token expiry ─────────────────────────────────────────────────────────────
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Set to "production" in Railway. The server enables stricter security and
# content-security-policy headers when NODE_ENV=production.
NODE_ENV="development"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your production web app URL in Railway (e.g. https://your-app.up.railway.app).
# The server logs a warning on startup if this still contains "localhost" in production.
CORS_ORIGIN="http://localhost:3000"

# ─── File storage (AWS S3) ────────────────────────────────────────────────────
# Leave empty for local disk storage (development only).
# Set all four values to enable S3-backed file storage in production.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ─── Password reset & email ───────────────────────────────────────────────────
# APP_URL is the public URL of the web frontend — used to build reset links.
# In Railway production: set to your web app Railway URL (no trailing slash).
APP_URL="http://localhost:3000"

# SMTP configuration for password reset and account setup emails.
# Required in production: reset/setup links are never logged there, so without
# SMTP no reset or setup link reaches the user. In development the links are
# logged to stdout when SMTP_HOST is empty.
#
# Example using Gmail App Password:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_USER="your-address@gmail.com"
#   SMTP_PASS="your-app-password"   # generate at myaccount.google.com/apppasswords
#   SMTP_FROM="ConstructOS <your-address@gmail.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@constructos.app"

# ─── Deployment security ──────────────────────────────────────────────────────
# Proxy hops to trust for the client IP (rate limits, audit logs). Unset/false =
# trust none. Set to the verified hop count (e.g. 1) or a comma-separated list of
# proxy IPs/CIDRs for the real deployment. "true" is rejected.
TRUST_PROXY=""

# Public company self-registration (POST /auth/register). Defaults to enabled
# outside production and disabled in production unless set to "true".
ALLOW_PUBLIC_REGISTRATION=""

# Server-sent events (/api/v1/events). Defaults to enabled outside production
# and disabled in production unless set to "true".
SSE_ENABLED=""

# ─── Daily report: private object storage ─────────────────────────────────────
# local (development/tests) or s3 (S3-compatible private bucket, e.g. Cloudflare
# R2). Production refuses local unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""
# HMAC key (32+ chars) for the local driver's short-lived signed file URLs.
FILE_URL_SECRET=""
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=""

# ─── Daily report: AI extraction ──────────────────────────────────────────────
# anthropic | fake | disabled. Defaults: fake in tests, disabled elsewhere.
# Real site notes may be sent to Anthropic only after data-processing approval.
DAILY_REPORT_AI_PROVIDER=""
ANTHROPIC_API_KEY=""
DAILY_REPORT_AI_MODEL="claude-sonnet-5-5"
DAILY_REPORT_AI_TIMEOUT_MS=""
DAILY_REPORT_AI_DAILY_CAP_PER_COMPANY=""
