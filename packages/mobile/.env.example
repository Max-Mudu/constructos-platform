# ─── API base URL ─────────────────────────────────────────────────────────────
# Development (Android emulator): http://10.0.2.2:3001/api/v1
# Development (iOS simulator):    http://localhost:3001/api/v1
# Development (physical device):  http://<your-machine-ip>:3001/api/v1
# Production (EAS build):         https://<your-railway-api-url>/api/v1
#
# This value is inlined at EAS build time. Set EXPO_PUBLIC_API_URL in your
# EAS project secrets (https://expo.dev) or in a .env file that is NOT
# committed to git. The .env file is excluded by .gitignore.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
